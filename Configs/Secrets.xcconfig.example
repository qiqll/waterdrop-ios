// Copy this file to Secrets.xcconfig and fill in real values
// Secrets.xcconfig is git-ignored and never committed

// 注意：xcconfig 把 "//" 当行内注释，URL 必须用 SLASH 变量拼，不能直接写 http://
SLASH = /

ALICLOUD_APP_KEY =
ALICLOUD_APP_SECRET =
ALICLOUD_AUTH_SDK_INFO =
ALICLOUD_SCHEME_CODE =
SERVER_BASE_URL = http:$(SLASH)$(SLASH)101.42.225.65:8080$(SLASH)api$(SLASH)
